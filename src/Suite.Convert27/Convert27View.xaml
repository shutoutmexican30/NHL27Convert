<UserControl x:Class="Suite.Convert27.Convert27View"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             xmlns:local="clr-namespace:Suite.Convert27"
             Background="#151a22" Foreground="#d8dee9" FontFamily="Segoe UI" FontSize="12">
  <UserControl.Resources>
    <local:PathToImageConverter x:Key="Img" />
    <local:ConfidenceToBrushConverter x:Key="ConfBrush" />
    <Style TargetType="Button">
      <Setter Property="Background" Value="#243042" /><Setter Property="Foreground" Value="#e6ebf2" />
      <Setter Property="BorderBrush" Value="#38465c" /><Setter Property="Padding" Value="10,4" /><Setter Property="Margin" Value="0,0,6,0" />
    </Style>
    <Style TargetType="TextBlock" x:Key="Caption"><Setter Property="Foreground" Value="#8c97a8" /><Setter Property="Margin" Value="0,0,6,0" /><Setter Property="VerticalAlignment" Value="Center" /></Style>
    <Style TargetType="ComboBox"><Setter Property="Margin" Value="0,0,10,0" /><Setter Property="VerticalAlignment" Value="Center" /></Style>
  </UserControl.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Folder pairing -->
    <Border Background="#1b2230" Padding="10,8" BorderBrush="#273246" BorderThickness="0,0,0,1">
      <StackPanel>
        <WrapPanel>
          <TextBlock Style="{StaticResource Caption}" Text="NHL 24 team" />
          <ComboBox Width="130" ItemsSource="{Binding Teams}" SelectedItem="{Binding Team}" />
          <TextBlock Style="{StaticResource Caption}" Text="NHL 24 folder" />
          <ComboBox x:Name="Folder24Box" Width="430" IsEditable="True" ItemsSource="{Binding Folders24}" Text="{Binding Folder24, UpdateSourceTrigger=LostFocus}"
                    SelectionChanged="Folder24_SelectionChanged" ToolTip="Any NHL 24 folder can be typed here, not only uniforms." />
          <TextBlock Style="{StaticResource Caption}" Text="takes art from NHL 27" />
          <ComboBox x:Name="Folder27Box" Width="430" IsEditable="True" ItemsSource="{Binding Proposals}" Text="{Binding Folder27, UpdateSourceTrigger=LostFocus}"
                    TextSearch.TextPath="Folder27" SelectionChanged="Folder27_SelectionChanged"
                    ToolTip="Proposed NHL 27 folders, best first. Type any NHL 27 folder to override.">
            <ComboBox.ItemTemplate>
              <DataTemplate>
                <StackPanel Orientation="Horizontal">
                  <Border Width="34" CornerRadius="3" Margin="0,0,6,0" Background="{Binding Confidence, Converter={StaticResource ConfBrush}}">
                    <TextBlock Text="{Binding Confidence, StringFormat={}{0:P0}}" Foreground="Black" HorizontalAlignment="Center" FontSize="11" />
                  </Border>
                  <TextBlock Text="{Binding Folder27}" />
                  <TextBlock Text="{Binding Reason, StringFormat=' — {0}'}" Foreground="#8c97a8" />
                </StackPanel>
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </WrapPanel>
        <WrapPanel Margin="0,8,0,0">
          <Button Content="Match textures" Click="Repropose_Click" FontWeight="SemiBold" Background="#2f6fd6" ToolTip="Matches every NHL 27 texture of the chosen uniform (jersey, pants, socks, helmet, gloves, branding arrays) to its NHL 24 slot. Rows you edited are kept." />
          <Button Content="Reset this folder" Click="Reset_Click" ToolTip="Recomputes every row, including ones you edited." />
          <Button Content="Match whole team" Click="ProposeTeam_Click" ToolTip="Every uniform folder of this team; folders you set by hand are kept." />
          <Button Content="Match all teams" Click="ProposeAll_Click" ToolTip="Every uniform folder of every team. Nothing is written to the game until Apply." />
          <Button Content="Save matches" Click="Save_Click" />
          <TextBlock Style="{StaticResource Caption}" Text="Mod name" Margin="12,0,6,0" />
          <TextBox x:Name="ModName" Width="200" Text="NHL 27 uniforms" VerticalContentAlignment="Center" Margin="0,0,6,0" />
          <Button Content="Add folder to mod list" Click="AddFolder_Click" />
          <Button Content="Add all matched folders" Click="AddAll_Click" />
          <Button Content="Mod list…" Click="ModList_Click" ToolTip="See every saved mod and exactly what it will write." />
          <Button Content="Apply…" Click="Apply_Click" FontWeight="SemiBold" Background="#2e7d4f" IsEnabled="False"
                  ToolTipService.ShowOnDisabled="True" ToolTip="Disabled until the apply target is fixed (it must be the real, closed, backed-up game folder)." />
        </WrapPanel>
        <WrapPanel Margin="0,8,0,0">
          <TextBlock Style="{StaticResource Caption}" Text="Replacement folder (DDS / PNG)" Margin="0,0,6,0" />
          <TextBox x:Name="ReplacementFolder" Width="420" VerticalContentAlignment="Center" Margin="0,0,6,0"
                   Text="{Binding Settings.ReplacementDir, Mode=OneWay}"
                   ToolTip="A folder of your own replacement images. Match from folder fills the rows that are still stock, by name and material role." />
          <Button Content="Browse…" Click="ReplacementBrowse_Click" />
          <Button Content="Match from folder" Click="MatchFolder_Click" />
        </WrapPanel>
        <DockPanel Margin="0,8,0,0">
          <Button DockPanel.Dock="Right" Content="Edit variant map" Click="EditVariants_Click" ToolTip="data\variant_map.json: default home/away variant per team in both games (hand-editable)" />
          <TextBlock Text="{Binding VariantInfo}" Foreground="#9fb4cf" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        </DockPanel>
      </StackPanel>
    </Border>

    <!-- Matcher and viewer side by side -->
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="5*" MinWidth="360" />
        <ColumnDefinition Width="6" />
        <ColumnDefinition Width="6*" MinWidth="360" />
      </Grid.ColumnDefinitions>

      <DataGrid x:Name="Grid" ItemsSource="{Binding Rows}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                HeadersVisibility="Column" GridLinesVisibility="Horizontal" RowHeight="116" Background="#151a22" RowBackground="#18202b"
                AlternatingRowBackground="#1b2430" Foreground="#d8dee9" BorderThickness="0" HorizontalGridLinesBrush="#243042"
                SelectionMode="Single" AllowDrop="True" Drop="Grid_Drop" DragOver="Grid_DragOver" RowDetailsVisibilityMode="VisibleWhenSelected"
                SelectionChanged="Grid_SelectionChanged">
        <DataGrid.ColumnHeaderStyle>
          <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#1f2836" /><Setter Property="Foreground" Value="#aab4c3" /><Setter Property="Padding" Value="6,4" /></Style>
        </DataGrid.ColumnHeaderStyle>
        <DataGrid.Columns>
          <DataGridTemplateColumn Header="NHL 24" Width="116" IsReadOnly="True">
            <DataGridTemplateColumn.CellTemplate><DataTemplate><Image Source="{Binding Thumb24, Converter={StaticResource Img}, ConverterParameter=224}" Width="108" Height="108" Stretch="Uniform" /></DataTemplate></DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn Header="Slot" Width="2*" IsReadOnly="True" SortMemberPath="Leaf">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="{Binding Leaf}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Slot}" />
                  <TextBlock Foreground="#8c97a8" FontSize="11"><Run Text="{Binding Garment, Mode=OneWay}" /> · <Run Text="{Binding Role, Mode=OneWay}" /></TextBlock>
                </StackPanel>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn Header="Source" Width="116" IsReadOnly="True">
            <DataGridTemplateColumn.CellTemplate><DataTemplate><Image Source="{Binding ThumbSource, Converter={StaticResource Img}, ConverterParameter=224}" Width="108" Height="108" Stretch="Uniform" /></DataTemplate></DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn Header="NHL 27 texture or image (type, pick or drop)" Width="3*">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding SourceDisplay}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding SourceText}" />
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
            <DataGridTemplateColumn.CellEditingTemplate>
              <DataTemplate>
                <ComboBox IsEditable="True" VerticalAlignment="Center" Margin="0"
                          ItemsSource="{Binding DataContext.Sources27, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                          Text="{Binding SourceText, UpdateSourceTrigger=LostFocus}" />
              </DataTemplate>
            </DataGridTemplateColumn.CellEditingTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn Header="Match" Width="64" SortMemberPath="Confidence" IsReadOnly="True">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <Border CornerRadius="3" Padding="4,1" VerticalAlignment="Center" HorizontalAlignment="Left"
                        Background="{Binding Confidence, Converter={StaticResource ConfBrush}}" ToolTip="{Binding Reason}">
                  <TextBlock Foreground="Black" FontSize="11">
                    <Run Text="{Binding Confidence, StringFormat={}{0:P0}, Mode=OneWay}" />
                  </TextBlock>
                </Border>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn Header="Alpha" Width="80">
            <DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Alpha, TargetNullValue=image}" VerticalAlignment="Center" /></DataTemplate></DataGridTemplateColumn.CellTemplate>
            <DataGridTemplateColumn.CellEditingTemplate>
              <DataTemplate>
                <ComboBox IsEditable="True" VerticalAlignment="Center" Text="{Binding Alpha, UpdateSourceTrigger=LostFocus, TargetNullValue=''}"
                          ToolTip="auto = keep the game's fabric-region alpha (rule 11); nodimples = auto and 102→51; empty = use the image's alpha">
                  <ComboBoxItem Content="auto" /><ComboBoxItem Content="nodimples" /><ComboBoxItem Content="" />
                </ComboBox>
              </DataTemplate>
            </DataGridTemplateColumn.CellEditingTemplate>
          </DataGridTemplateColumn>
          <DataGridCheckBoxColumn Header="Edited" Binding="{Binding Manual}" Width="52" />
          <DataGridTextColumn Header="Why" Binding="{Binding Reason}" Width="3*" IsReadOnly="True">
            <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap" /><Setter Property="Foreground" Value="#8c97a8" /><Setter Property="VerticalAlignment" Value="Center" /></Style></DataGridTextColumn.ElementStyle>
          </DataGridTextColumn>
        </DataGrid.Columns>
        <DataGrid.RowDetailsTemplate>
          <DataTemplate>
            <Border Background="#121820" Padding="118,6,6,6">
              <StackPanel>
                <TextBlock Foreground="#8c97a8" Text="{Binding Slot}" Margin="0,0,0,4" />
                <ItemsControl ItemsSource="{Binding Layers}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <StackPanel Orientation="Horizontal" Margin="0,1" AllowDrop="True" Drop="Layer_Drop" Tag="{Binding}">
                        <TextBlock Width="60" Foreground="#aab4c3"><Run Text="layer " /><Run Text="{Binding Layer, Mode=OneWay}" /></TextBlock>
                        <ComboBox Width="420" IsEditable="True"
                                  ItemsSource="{Binding DataContext.Sources27, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                  Text="{Binding Source27, UpdateSourceTrigger=LostFocus}" />
                        <TextBlock Margin="8,0" Foreground="#8c97a8" Text="{Binding FilePath, StringFormat='file: {0}'}" VerticalAlignment="Center" />
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Foreground="#6c7788" Text="Drop an image on a layer row to use it for that layer." Margin="0,4,0,0" />
              </StackPanel>
            </Border>
          </DataTemplate>
        </DataGrid.RowDetailsTemplate>
      </DataGrid>

      <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="#273246" />

      <Grid Grid.Column="2">
        <wv2:WebView2 x:Name="Viewer" DefaultBackgroundColor="#10141b" />
        <TextBlock x:Name="ViewerError" Visibility="Collapsed" Foreground="#e88" TextWrapping="Wrap" Margin="20" />
      </Grid>
    </Grid>

    <Border Grid.Row="2" Background="#1b2230" Padding="10,5">
      <DockPanel>
        <ProgressBar DockPanel.Dock="Right" Width="120" Height="8" IsIndeterminate="{Binding Busy}" Visibility="Visible" />
        <TextBlock Text="{Binding Status}" Foreground="#aab4c3" TextTrimming="CharacterEllipsis" />
      </DockPanel>
    </Border>
  </Grid>
</UserControl>
