<UserControl x:Class="Suite.Convert27.Studio.EquipmentStudioView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#151a22" Foreground="#e6ebf2" FontFamily="Segoe UI" FontSize="12">
  <UserControl.Resources>
    <Style TargetType="Button">
      <Setter Property="Background" Value="#243042" /><Setter Property="Foreground" Value="#e6ebf2" />
      <Setter Property="BorderBrush" Value="#38465c" /><Setter Property="Padding" Value="10,5" /><Setter Property="Margin" Value="0,0,7,7" />
    </Style>
    <Style TargetType="ComboBox"><Setter Property="Margin" Value="0,0,8,8" /><Setter Property="MinHeight" Value="27" /></Style>
    <Style x:Key="Label" TargetType="TextBlock"><Setter Property="Foreground" Value="#9fb4cf" /><Setter Property="Margin" Value="0,9,0,4" /><Setter Property="FontSize" Value="11" /></Style>
    <Style x:Key="Panel" TargetType="Border"><Setter Property="Background" Value="#1b2230" /><Setter Property="BorderBrush" Value="#273246" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="5" /><Setter Property="Padding" Value="12" /><Setter Property="Margin" Value="0,0,0,10" /></Style>
  </UserControl.Resources>
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <Border Style="{StaticResource Panel}" Margin="10,10,10,0">
      <StackPanel>
        <TextBlock Text="Equipment &amp; uniform slots" FontSize="20" FontWeight="SemiBold" />
        <TextBlock Text="Edit the new Fanatics equipment safely. Stock helmets, gloves and all goalie equipment are protected." Foreground="#9fb4cf" Margin="0,3,0,9" TextWrapping="Wrap" />
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="260" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Style="{StaticResource Label}" Text="GAME BUILD · BOTH READ AND APPLY TARGET" Margin="0,0,0,4" />
            <ComboBox ItemsSource="{Binding Builds}" SelectedItem="{Binding SelectedBuild}" DisplayMemberPath="Name" />
          </StackPanel>
          <StackPanel Grid.Column="1">
            <TextBlock Style="{StaticResource Label}" Text="SAVED NEW-UNIFORM MOD · NAMES, HOME/AWAY SOURCES AND SLOT MAPS" Margin="0,0,0,4" />
            <ComboBox ItemsSource="{Binding Mods}" SelectedItem="{Binding SelectedMod}" DisplayMemberPath="Name" />
          </StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom">
            <Button Content="Browse build…" Click="BrowseBuild_Click" />
            <Button Content="Reload" Click="Reload_Click" ToolTip="Discard edits in memory and reread the selected build." />
          </StackPanel>
        </Grid>
        <TextBox Text="{Binding GameDir, UpdateSourceTrigger=LostFocus}" Padding="5,3" ToolTip="The selected build. Apply never targets a different build." />
      </StackPanel>
    </Border>

    <Grid Grid.Row="1" Margin="10,10,10,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="440" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
      <Border Style="{StaticResource Panel}" Margin="0">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="1 · Choose a helmet or glove row" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,6" />
            <TextBlock Style="{StaticResource Label}" Text="TEAM" Margin="0,0,0,4" />
            <ComboBox ItemsSource="{Binding Teams}" SelectedItem="{Binding SelectedTeam}" DisplayMemberPath="Name" />
            <TextBlock Style="{StaticResource Label}" Text="UNIFORM / VARIANT" Margin="0,0,0,4" />
            <ComboBox ItemsSource="{Binding Variants}" SelectedItem="{Binding SelectedVariant}" DisplayMemberPath="Name" />
            <TextBlock Style="{StaticResource Label}" Text="EQUIPMENT" Margin="0,0,0,4" />
            <ComboBox ItemsSource="{Binding Types}" SelectedItem="{Binding SelectedType}" DisplayMemberPath="Name" />
          </StackPanel>
          <StackPanel DockPanel.Dock="Bottom">
            <Border Background="#202a39" CornerRadius="4" Padding="9" Margin="0,8,0,0">
              <StackPanel>
                <TextBlock Text="2 · Duplicate explicitly, never automatically" Foreground="#e6ebf2" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Text="Copies the selected donor's type, brand, era and 15 colors. Jersey art comes from the installed target uniform, not the donor." Foreground="#9fb4cf" TextWrapping="Wrap" Margin="0,4,0,7" />
                <DockPanel>
                  <Button DockPanel.Dock="Right" Content="Duplicate donor" Click="Duplicate_Click" IsEnabled="{Binding CanDuplicate}" Margin="0,0,0,5" />
                  <ComboBox ItemsSource="{Binding TargetVariants}" SelectedItem="{Binding TargetVariant}" Width="74" Margin="0,0,8,5" />
                </DockPanel>
                <TextBlock Text="24 = Fanatics away · 25 = Fanatics home" Foreground="#8fa3bc" Margin="0,0,0,4" />
              </StackPanel>
            </Border>
          </StackPanel>
          <ListBox ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}" Background="#121820" BorderBrush="#273246" Margin="0,4,0,0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate><DataTemplate>
              <Border Padding="6,5" BorderBrush="#273246" BorderThickness="0,0,0,1">
                <StackPanel>
                  <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding WriteState}" Foreground="#8faccd" FontSize="10" />
                    <TextBlock FontWeight="SemiBold"><Run Text="{Binding TeamName}" /><Run Text=" · " /><Run Text="{Binding Key.Type}" /></TextBlock>
                  </DockPanel>
                  <TextBlock Text="{Binding VariantName}" Foreground="#bdc9d9" Margin="0,2,0,0" />
                  <TextBlock Foreground="#8fa3bc" FontSize="10" TextTrimming="CharacterEllipsis">
                    <Run Text="brand " /><Run Text="{Binding Key.Brand}" /><Run Text=" · art " /><Run Text="{Binding Key.JerseyArtId}" /><Run Text=" · era " /><Run Text="{Binding Key.Era}" />
                  </TextBlock>
                  <TextBlock Text="{Binding Palette}" FontFamily="Consolas" Foreground="#a8c4e3" FontSize="10" />
                </StackPanel>
              </Border>
            </DataTemplate></ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>

      <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <Border Style="{StaticResource Panel}">
            <StackPanel>
              <TextBlock Text="3 · Review all 15 color zones" FontSize="15" FontWeight="SemiBold" />
              <TextBlock Text="{Binding SelectionDetails}" Foreground="#9fb4cf" TextWrapping="Wrap" Margin="0,4,0,9" />
              <ItemsControl ItemsSource="{Binding Zones}" IsEnabled="{Binding CanEditSelected}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate><DataTemplate>
                  <Border Width="132" Background="#121820" CornerRadius="3" Padding="6" Margin="0,0,7,7">
                    <StackPanel>
                      <TextBlock Text="{Binding Label}" Foreground="#9fb4cf" FontSize="10" />
                      <DockPanel Margin="0,3,0,0">
                        <Border DockPanel.Dock="Right" Width="23" Background="{Binding Swatch}" BorderBrush="#62718a" BorderThickness="1" CornerRadius="2" />
                        <TextBox Text="{Binding Hex, UpdateSourceTrigger=PropertyChanged}" MaxLength="6" FontFamily="Consolas" FontSize="13" Margin="0,0,6,0" ToolTip="Six-digit RGB color, without #." />
                      </DockPanel>
                    </StackPanel>
                  </Border>
                </DataTemplate></ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Text="Select a Fanatics home or away row to edit. A stock row is read only, but can be explicitly duplicated into 24 or 25." Foreground="#8fa3bc" TextWrapping="Wrap" />
            </StackPanel>
          </Border>

          <Border Style="{StaticResource Panel}">
            <StackPanel>
              <TextBlock Text="4 · Validate, back up, apply" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8" />
              <WrapPanel>
                <Button Content="Review changes" Click="Review_Click" IsEnabled="{Binding CanEdit}" />
                <Button Content="Restore verified NHL 27 colors" Click="ResetColors_Click" IsEnabled="{Binding CanEdit}" ToolTip="Stages the numbered NHL 27 home/away colors in memory. It does not write until Apply." />
                <Button Content="Apply to selected build…" Click="Apply_Click" IsEnabled="{Binding CanEdit}" Background="#246ba8" FontWeight="SemiBold" />
              </WrapPanel>
              <TextBlock Text="{Binding Preflight}" Foreground="#b5c6db" TextWrapping="Wrap" Margin="0,4,0,0" />
            </StackPanel>
          </Border>

          <Border Style="{StaticResource Panel}">
            <StackPanel>
              <Expander Foreground="#e6ebf2" IsExpanded="False">
                <Expander.Header><TextBlock Text="{Binding SlotSummary}" TextWrapping="Wrap" MaxWidth="650" /></Expander.Header>
                <StackPanel Margin="0,10,0,0">
                  <TextBlock Text="Read-only pixel and role verification of each installed color/normal array. Larger donor layouts are valid only when every unused layer is explicitly blank; duplicated or shifted artwork is blocked." Foreground="#9fb4cf" TextWrapping="Wrap" />
                  <ListBox ItemsSource="{Binding SlotErrors}" Foreground="#f0b66a" Background="#121820" BorderThickness="0" MaxHeight="110" Margin="0,6,0,0" />
                  <ListView ItemsSource="{Binding SlotRows}" Background="#121820" BorderBrush="#273246" Height="245" Margin="0,6,0,0" ScrollViewer.HorizontalScrollBarVisibility="Auto">
                    <ListView.View><GridView>
                      <GridViewColumn Header="Team" DisplayMemberBinding="{Binding TeamName}" Width="100" />
                      <GridViewColumn Header="Kit" DisplayMemberBinding="{Binding Kit}" Width="55" />
                      <GridViewColumn Header="Installed copy" DisplayMemberBinding="{Binding Copy}" Width="100" />
                      <GridViewColumn Header="Depth" DisplayMemberBinding="{Binding Depth}" Width="50" />
                      <GridViewColumn Header="Art layers" DisplayMemberBinding="{Binding RequiredDepth}" Width="65" />
                      <GridViewColumn Header="Result" DisplayMemberBinding="{Binding Status}" Width="160" />
                      <GridViewColumn Header="Placed logo slots, including blanks" DisplayMemberBinding="{Binding RoleOrder}" Width="460" />
                      <GridViewColumn Header="Resource" DisplayMemberBinding="{Binding Slot}" Width="400" />
                    </GridView></ListView.View>
                  </ListView>
                </StackPanel>
              </Expander>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Grid>
    <Border Grid.Row="2" Background="#1b2230" BorderBrush="#273246" BorderThickness="0,1,0,0" Padding="12,8" Margin="10,10,10,10">
      <DockPanel>
        <ProgressBar DockPanel.Dock="Right" Width="130" Height="7" IsIndeterminate="{Binding Busy}" />
        <TextBlock Text="{Binding Status}" Foreground="#b5c6db" TextWrapping="Wrap" Margin="0,0,12,0" />
      </DockPanel>
    </Border>
  </Grid>
</UserControl>
