<UserControl x:Class="Suite.Convert27.Studio.UniformStudioView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c27="clr-namespace:Suite.Convert27"
             Background="#151a22" Foreground="#e6ebf2" FontFamily="Segoe UI" FontSize="12">
  <UserControl.Resources>
    <c27:PathToImageConverter x:Key="Img" />
    <c27:ConfidenceToBrushConverter x:Key="ConfBrush" />
    <SolidColorBrush x:Key="Accent" Color="#2f6fd6" />
    <DrawingBrush x:Key="Checker" TileMode="Tile" Viewport="0,0,16,16" ViewportUnits="Absolute">
      <DrawingBrush.Drawing>
        <DrawingGroup>
          <GeometryDrawing Brush="#2a313d" Geometry="M0,0 H2 V2 H0Z" />
          <GeometryDrawing Brush="#222832" Geometry="M0,0 H1 V1 H0Z M1,1 H2 V2 H1Z" />
        </DrawingGroup>
      </DrawingBrush.Drawing>
    </DrawingBrush>
    <Style TargetType="Button">
      <Setter Property="Background" Value="#243042" /><Setter Property="Foreground" Value="#e6ebf2" />
      <Setter Property="BorderBrush" Value="#38465c" /><Setter Property="Padding" Value="10,4" />
    </Style>
    <Style x:Key="Label" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#9fb4cf" /><Setter Property="Margin" Value="0,12,0,4" /><Setter Property="FontSize" Value="11" />
    </Style>
    <Style x:Key="Tag" TargetType="Border">
      <Setter Property="CornerRadius" Value="3" /><Setter Property="Padding" Value="6,1" /><Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
  </UserControl.Resources>

  <TabControl x:Name="StudioTabs" Background="#151a22" BorderThickness="0">
    <TabItem Header="Texture replacements">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="300" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Left panel -->
    <Border Background="#1b2230" BorderBrush="#273246" BorderThickness="0,0,1,0" Padding="14,6,14,14">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top">
          <TextBlock Style="{StaticResource Label}" Text="NHL 24 GAME FOLDER" />
          <DockPanel>
            <Button DockPanel.Dock="Right" Content="Browse…" Click="BrowseGame_Click" Margin="6,0,0,0" />
            <TextBox Text="{Binding GameDir, UpdateSourceTrigger=LostFocus}" Padding="4,3" ToolTip="NHL24PC build (game\ + game-UPDATE\) or an extracted CUSA37933 folder" />
          </DockPanel>
          <TextBlock Style="{StaticResource Label}" Text="TEAM" />
          <ComboBox ItemsSource="{Binding Teams}" SelectedItem="{Binding Team}" />
          <TextBlock Style="{StaticResource Label}" Text="UNIFORM / SET" />
          <ComboBox ItemsSource="{Binding Uniforms}" SelectedItem="{Binding Uniform}" />
          <TextBlock Style="{StaticResource Label}" Text="REPLACEMENT TEXTURE FOLDER (DDS / PNG)" />
          <DockPanel>
            <Button DockPanel.Dock="Right" Content="Browse…" Click="BrowseReplacements_Click" Margin="6,0,0,0" />
            <TextBox Text="{Binding ReplacementDir, UpdateSourceTrigger=LostFocus}" Padding="4,3" />
          </DockPanel>
          <CheckBox Content="Also offer the matched NHL 27 uniform" IsChecked="{Binding OfferNhl27}" Foreground="#c9d3e0" Margin="0,10,0,0"
                    ToolTip="Adds the NHL 27 textures of the uniform paired through the variant map as replacement choices." />
          <WrapPanel Margin="0,14,0,0">
            <Button Content="Auto-match" Click="AutoMatch_Click" Margin="0,0,6,6" ToolTip="Re-match every card you have not set by hand." />
            <Button Content="Save to mod library" Click="Save_Click" Background="{StaticResource Accent}" Margin="0,0,6,6" FontWeight="SemiBold" />
          </WrapPanel>
          <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" Foreground="#aab4c3" Margin="0,6,0,0" />
          <TextBlock Style="{StaticResource Label}" Text="UNMATCHED REPLACEMENT FILES" />
        </StackPanel>
        <ListBox ItemsSource="{Binding UnmatchedFiles}" Background="#151a22" BorderBrush="#273246" Foreground="#f0c04c" MinHeight="60">
          <ListBox.ItemTemplate>
            <DataTemplate><TextBlock Text="{Binding Name}" ToolTip="{Binding Path}" /></DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>

    <!-- Card grid -->
    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="10">
      <ItemsControl x:Name="CardList" ItemsSource="{Binding Cards}">
        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Width="372" Margin="6" Padding="10" CornerRadius="6" Background="#1b2230" BorderBrush="#2a3750" BorderThickness="1"
                    AllowDrop="True" Drop="Card_Drop">
              <StackPanel>
                <DockPanel>
                  <Border DockPanel.Dock="Right" Style="{StaticResource Tag}" x:Name="StateTag" Background="#3a4558">
                    <TextBlock Text="{Binding State}" FontSize="10" FontWeight="SemiBold" />
                  </Border>
                  <TextBlock Text="{Binding Leaf}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Slot}" />
                </DockPanel>
                <TextBlock Text="{Binding Details}" Foreground="#8c97a8" Margin="0,2,0,8" TextTrimming="CharacterEllipsis" />
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="8" /><ColumnDefinition /></Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="ORIGINAL" FontSize="10" Foreground="#9fb4cf" Margin="0,0,0,3" />
                    <Border Height="166" Background="{StaticResource Checker}" CornerRadius="3" Cursor="Hand" MouseLeftButtonUp="Original_Click" ToolTip="Click to inspect full size">
                      <Image Source="{Binding OriginalPng, Converter={StaticResource Img}, ConverterParameter=320}" Stretch="Uniform" Margin="3" />
                    </Border>
                  </StackPanel>
                  <StackPanel Grid.Column="2">
                    <TextBlock Text="NEW" FontSize="10" Foreground="#9fb4cf" Margin="0,0,0,3" />
                    <Border Height="166" Background="{StaticResource Checker}" CornerRadius="3" Cursor="Hand" MouseLeftButtonUp="New_Click"
                            BorderThickness="2" BorderBrush="{Binding Score, Converter={StaticResource ConfBrush}}" ToolTip="Click to choose a replacement">
                      <Grid>
                        <Image Source="{Binding NewPreview, Converter={StaticResource Img}, ConverterParameter=320}" Stretch="Uniform" Margin="3" />
                        <TextBlock Text="click to choose" Foreground="#6c7788" HorizontalAlignment="Center" VerticalAlignment="Center" x:Name="Hint" />
                      </Grid>
                    </Border>
                  </StackPanel>
                </Grid>
                <TextBlock Text="{Binding NewName}" Margin="0,8,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding New.Path}" />
                <TextBlock Foreground="#8c97a8" TextTrimming="CharacterEllipsis" ToolTip="{Binding Reason}">
                  <Run Text="{Binding Score, StringFormat={}{0:P0}, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Reason, Mode=OneWay}" />
                </TextBlock>
                <DockPanel Margin="0,8,0,0">
                  <CheckBox Content="Replace" IsChecked="{Binding Replace}" Foreground="#e6ebf2" VerticalAlignment="Center" Click="Replace_Click" />
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Choose…" Click="Choose_Click" Margin="0,0,6,0" />
                    <Button Content="Browse…" Click="Browse_Click" />
                  </StackPanel>
                </DockPanel>
              </StackPanel>
            </Border>
            <DataTemplate.Triggers>
              <DataTrigger Binding="{Binding State}" Value="REPLACED"><Setter TargetName="StateTag" Property="Background" Value="#2e7d4f" /></DataTrigger>
              <DataTrigger Binding="{Binding State}" Value="COEFF KEPT STOCK"><Setter TargetName="StateTag" Property="Background" Value="#5a4a1a" /></DataTrigger>
              <DataTrigger Binding="{Binding State}" Value="UNUSED"><Setter TargetName="StateTag" Property="Background" Value="#5c2b33" /></DataTrigger>
              <DataTrigger Binding="{Binding New}" Value="{x:Null}" />
            </DataTemplate.Triggers>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <!-- Status, progress, activity log -->
    <Border Grid.Row="1" Grid.ColumnSpan="2" Background="#1b2230" BorderBrush="#273246" BorderThickness="0,1,0,0" Padding="10,5">
      <StackPanel>
        <DockPanel>
          <ProgressBar DockPanel.Dock="Right" Width="140" Height="8" IsIndeterminate="{Binding Busy}" />
          <TextBlock DockPanel.Dock="Right" Margin="0,0,12,0" Foreground="#e88">
            <Run Text="{Binding Errors, Mode=OneWay}" /><Run Text=" errors" />
          </TextBlock>
          <TextBlock Text="{Binding Status}" Foreground="#aab4c3" TextTrimming="CharacterEllipsis" />
        </DockPanel>
        <Expander Header="Activity log" Foreground="#9fb4cf" Margin="0,4,0,0">
          <ListBox ItemsSource="{Binding Log}" Height="160" Background="#121820" Foreground="#aab4c3" BorderThickness="0" FontFamily="Consolas" FontSize="11" />
        </Expander>
      </StackPanel>
    </Border>

    <!-- In-window overlays: choose a replacement / inspect full size -->
    <Grid x:Name="Overlay" Grid.ColumnSpan="2" Grid.RowSpan="2" Background="#CC0b0f15" Visibility="Collapsed" MouseLeftButtonUp="Overlay_Click">
      <Border x:Name="ChoosePanel" Background="#1b2230" BorderBrush="#2f6fd6" BorderThickness="1" CornerRadius="8" Padding="14" Margin="80,40"
              MouseLeftButtonUp="Panel_Click" Visibility="Collapsed">
        <DockPanel>
          <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <Button DockPanel.Dock="Right" Content="Close" Click="CloseOverlay_Click" />
            <Button DockPanel.Dock="Right" Content="Keep stock texture" Click="KeepStock_Click" Margin="0,0,8,0" />
            <TextBlock x:Name="ChooseTitle" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
          </DockPanel>
          <ListBox x:Name="ChoiceList" Background="#151a22" BorderThickness="0" MouseDoubleClick="Choice_Pick" KeyUp="Choice_Key"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Border Width="176" Margin="4" Padding="6" Background="#1f2836" CornerRadius="4">
                  <StackPanel>
                    <Border Height="150" Background="{StaticResource Checker}">
                      <Image Source="{Binding File.Preview, Converter={StaticResource Img}, ConverterParameter=320}" Stretch="Uniform" />
                    </Border>
                    <TextBlock Text="{Binding File.Name}" Foreground="#e6ebf2" TextTrimming="CharacterEllipsis" ToolTip="{Binding File.Path}" Margin="0,4,0,0" />
                    <TextBlock Foreground="#8c97a8" FontSize="11" TextWrapping="Wrap">
                      <Run Text="{Binding Score, StringFormat={}{0:P0}, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding File.Source, Mode=OneWay}" />
                      <LineBreak /><Run Text="{Binding Reason, Mode=OneWay}" />
                    </TextBlock>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>
      <Border x:Name="InspectPanel" Background="#1b2230" BorderBrush="#2f6fd6" BorderThickness="1" CornerRadius="8" Padding="10" Margin="40,24"
              MouseLeftButtonUp="Panel_Click" Visibility="Collapsed">
        <DockPanel>
          <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <Button DockPanel.Dock="Right" Content="Close" Click="CloseOverlay_Click" />
            <Slider x:Name="Zoom" DockPanel.Dock="Right" Width="160" Minimum="0.1" Maximum="4" Value="1" Margin="0,0,10,0" VerticalAlignment="Center" ToolTip="Zoom (1 = fit)" />
            <TextBlock x:Name="InspectTitle" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
          </DockPanel>
          <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="{StaticResource Checker}" x:Name="InspectScroll">
            <Image x:Name="InspectImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor" />
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Grid>
  </Grid>
    </TabItem>
    <TabItem Header="Equipment &amp; slots">
      <ContentControl x:Name="EquipmentHost" />
    </TabItem>
  </TabControl>
</UserControl>
