<UserControl x:Class="Suite.App.Pages.TexturesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c27="clr-namespace:Suite.Convert27;assembly=Suite.Convert27"
             Background="#151a22" Foreground="#e6ebf2" FontFamily="Segoe UI" FontSize="12">
  <UserControl.Resources>
    <c27:PathToImageConverter x:Key="Img" />
    <Style TargetType="Button">
      <Setter Property="Background" Value="#243042" /><Setter Property="Foreground" Value="#e6ebf2" />
      <Setter Property="BorderBrush" Value="#38465c" /><Setter Property="Padding" Value="8,4" /><Setter Property="Margin" Value="0,0,6,0" />
    </Style>
    <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}"><Setter Property="Margin" Value="0,0,10,0" /><Setter Property="VerticalAlignment" Value="Center" /></Style>
    <Style x:Key="Caption" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#8c97a8" /><Setter Property="Margin" Value="10,0,6,0" /><Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style TargetType="TreeView">
      <Setter Property="Background" Value="#141a24" /><Setter Property="BorderBrush" Value="#273246" />
      <Setter Property="Foreground" Value="#e6ebf2" /><Setter Property="FontSize" Value="14" />
    </Style>
    <Style TargetType="TreeViewItem">
      <Setter Property="IsExpanded" Value="False" />
    </Style>
  </UserControl.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Filters -->
    <Border Background="#1b2230" Padding="10,8" BorderBrush="#273246" BorderThickness="0,0,0,1">
      <StackPanel>
        <WrapPanel>
          <TextBlock Style="{StaticResource Caption}" Text="Game" Margin="0,0,6,0" />
          <ComboBox x:Name="Game" Width="110" SelectionChanged="Game_Changed">
            <ComboBoxItem Content="NHL 24" IsSelected="True" />
            <ComboBoxItem Content="NHL 27" />
          </ComboBox>
          <TextBlock Style="{StaticResource Caption}" Text="Search all textures" />
          <TextBox x:Name="Search" Width="300" VerticalContentAlignment="Center" TextChanged="Search_Changed"
                   ToolTip="Searches every texture of the game: words match path parts (team:detroit color, jersey, 512, kind:texturearray), a trailing * matches a prefix, anything else matches anywhere in the path. Results replace the folder view until cleared." />
          <TextBlock x:Name="Mode" Style="{StaticResource Caption}" Text="" />
        </WrapPanel>
        <WrapPanel Margin="0,8,0,0">
          <TextBlock Style="{StaticResource Caption}" Text="Selected" Margin="0,0,6,0" />
          <TextBlock x:Name="Selection" Text="(none)" VerticalAlignment="Center" Foreground="#aab4c3" Margin="0,0,12,0" MaxWidth="520" TextTrimming="CharacterEllipsis" />
          <Button Content="Export current (PNG)…" Click="Export_Click"
                  ToolTip="Saves what the game holds now (every layer of an array) as PNG, to edit and import back." />
          <TextBlock Style="{StaticResource Caption}" Text="Layer" />
          <TextBox x:Name="Layer" Width="36" VerticalContentAlignment="Center" Margin="0,0,6,0"
                   ToolTip="For logo arrays (branding_*_array): the layer to replace, 0 = first (see Export). Blank = a whole sheet." />
          <Button Content="Choose replacement…" Click="Replace_Click" Background="#2f6fd6" />
          <Button Content="Clear replacement" Click="Clear_Click" />
          <TextBlock Style="{StaticResource Caption}" Text="Mod name" />
          <TextBox x:Name="ModName" Width="210" Text="Texture replacements" VerticalContentAlignment="Center" Margin="0,0,6,0" />
          <Button Content="Add replacements to mod list" Click="Save_Click" FontWeight="SemiBold" />
          <Button Content="Show replacements" Click="ShowReplacements_Click" />
        </WrapPanel>
        <WrapPanel Margin="0,8,0,0">
          <Button Content="Apply mod list to game" Click="Apply_Click" FontWeight="SemiBold" Background="#2f8a4a"
                  ToolTip="Writes the whole mod list into the apply target (Settings) with the suite's writer: backup, every copy, read-back. Close NHL 24 first." />
          <Button Content="Undo last apply" Click="Undo_Click"
                  ToolTip="Puts the game back to the backup taken right before the last apply." />
          <Button Content="Open mod list…" Click="ModList_Click" />
        </WrapPanel>
      </StackPanel>
    </Border>

    <!-- Folder tree + texture grid -->
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="330" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Border Background="#141a24" BorderBrush="#273246" BorderThickness="0,0,1,0">
          <TreeView x:Name="Tree" SelectedItemChanged="Tree_Changed" TreeViewItem.Expanded="Tree_Expanded" FontSize="14">
          <TreeView.Resources>
            <Style TargetType="TreeViewItem">
              <Setter Property="IsExpanded" Value="False" />
              <Setter Property="FontSize" Value="14" />
              <Setter Property="Padding" Value="2,3" />
              <Setter Property="Foreground" Value="#e6ebf2" />
            </Style>
          </TreeView.Resources>
        </TreeView>
      </Border>
      <GridSplitter Grid.Column="1" Width="4" Background="#273246" HorizontalAlignment="Center" VerticalAlignment="Stretch" />
      <ScrollViewer Grid.Column="2" Padding="10" VerticalScrollBarVisibility="Auto">
        <ItemsControl x:Name="CardList">
          <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Width="156" Margin="5" Padding="6" Background="#1b2230" BorderBrush="#2a3750" BorderThickness="1" CornerRadius="4">
                <StackPanel>
                  <Border Height="128" Background="#222832" CornerRadius="3" Cursor="Hand"
                          MouseLeftButtonUp="Card_Click" MouseLeftButtonDown="Card_Down" Tag="{Binding}" ToolTip="Click to select, then Choose replacement… Double-click for a full-size view with channels.">
                    <Grid>
                      <TextBlock Text="no picture" Foreground="#5a6372" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                      <Image Source="{Binding Preview, Converter={StaticResource Img}, ConverterParameter=300}" Stretch="Uniform" Margin="2" />
                    </Grid>
                  </Border>
                  <TextBlock Text="{Binding Leaf}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" ToolTip="{Binding Slot}" />
                  <TextBlock Text="{Binding Sub}" Foreground="#8c97a8" FontSize="11.5" TextTrimming="CharacterEllipsis" ToolTip="{Binding Sub}" />
                  <TextBlock Text="{Binding ReplaceText}" Foreground="#5fc97a" FontSize="11.5" TextTrimming="CharacterEllipsis"
                             ToolTip="{Binding Replacement}" />
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Grid>

    <!-- Status -->
    <Border Grid.Row="2" Background="#1b2230" Padding="10,5" BorderBrush="#273246" BorderThickness="0,1,0,0">
      <DockPanel>
        <ProgressBar x:Name="Progress" DockPanel.Dock="Right" Width="140" Height="8" />
        <TextBlock x:Name="Status" Foreground="#aab4c3" TextTrimming="CharacterEllipsis" />
      </DockPanel>
    </Border>
  </Grid>
</UserControl>
