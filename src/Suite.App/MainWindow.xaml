<Window x:Class="Suite.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Center Ice Modding Suite" Height="940" Width="1680" MinWidth="1280" MinHeight="720"
        WindowStartupLocation="CenterScreen" Icon="Assets/cims.ico"
        Background="#151a22" Foreground="#e6ebf2" FontFamily="Segoe UI" FontSize="13">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="210" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- Sidebar -->
    <Border Background="#0e1a2e" BorderBrush="#1d2b44" BorderThickness="0,0,1,0">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="14,16,14,18" Orientation="Horizontal">
          <Image Source="Assets/cims-logo-64.png" Width="40" Height="40" />
          <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="CENTER ICE" FontSize="10" Foreground="#9fb4cf" />
            <TextBlock Text="Modding Suite" FontSize="16" FontWeight="SemiBold" />
          </StackPanel>
        </StackPanel>
        <TextBlock DockPanel.Dock="Bottom" Margin="16,10" Foreground="#5f7391" FontSize="11" x:Name="VersionText" />
        <StackPanel x:Name="Nav">
          <RadioButton Style="{StaticResource NavButton}" GroupName="nav" Tag="home" Content="Home" IsChecked="True" Checked="Nav_Checked" />
          <RadioButton Style="{StaticResource NavButton}" GroupName="nav" Tag="convert27" Content="Convert 27" Checked="Nav_Checked" />
          <RadioButton Style="{StaticResource NavButton}" GroupName="nav" Tag="centerice" Content="Center ice" Checked="Nav_Checked" />
          <RadioButton Style="{StaticResource NavButton}" GroupName="nav" Tag="hotspots" Content="Ice hotspots" Checked="Nav_Checked" />
          <RadioButton Style="{StaticResource NavButton}" GroupName="nav" Tag="textures" Content="Texture suite" Checked="Nav_Checked" />
          <RadioButton Style="{StaticResource NavButton}" GroupName="nav" Tag="patches" Content="Patches" Checked="Nav_Checked" />
          <RadioButton Style="{StaticResource NavButton}" GroupName="nav" Tag="teams" Content="Teams &amp; roster" Checked="Nav_Checked" />
          <RadioButton Style="{StaticResource NavButton}" GroupName="nav" Tag="dbstudio" Content="Database studio" Checked="Nav_Checked" />
          <RadioButton Style="{StaticResource NavButton}" GroupName="nav" Tag="scorebug" Content="Scorebug" Checked="Nav_Checked" />
          <RadioButton Style="{StaticResource NavButton}" GroupName="nav" Tag="sounds" Content="Sounds" Checked="Nav_Checked" />
          <RadioButton Style="{StaticResource NavButton}" GroupName="nav" Tag="ui" Content="UI scripts" Checked="Nav_Checked" />
          <RadioButton Style="{StaticResource NavButton}" GroupName="nav" Tag="apply" Content="Apply &amp; restore" Checked="Nav_Checked" />
          <RadioButton Style="{StaticResource NavButton}" GroupName="nav" Tag="installer" Content="Build mod installer" Checked="Nav_Checked" />
          <RadioButton Style="{StaticResource NavButton}" GroupName="nav" Tag="settings" Content="Settings &amp; about" Checked="Nav_Checked" />
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- Header + page -->
    <Grid Grid.Column="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <Border Background="#121e33" BorderBrush="#1d2b44" BorderThickness="0,0,0,1" Padding="18,10">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="180" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock x:Name="PageTitle" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,18,0" />
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,22,0">
            <TextBlock Text="Supports:" Foreground="#9fb4cf" VerticalAlignment="Center" Margin="0,0,8,0" />
            <Border Style="{StaticResource Chip}" Background="#1d3d6b"><TextBlock Text="NHL 27 (PS5)" /></Border>
            <TextBlock Text="·" Foreground="#5f7391" VerticalAlignment="Center" Margin="0,0,6,0" />
            <Border Style="{StaticResource Chip}" Background="#c8102e"><TextBlock Text="NHL 24 (PS4)" /></Border>
          </StackPanel>
          <StackPanel Grid.Column="2" Width="380" VerticalAlignment="Center">
            <TextBlock Text="NHL 24 BUILD" Foreground="#b3c4da" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,4" />
            <DockPanel>
              <Button x:Name="BrowseGameButton" DockPanel.Dock="Right" Content="Browse…" Style="{StaticResource BrowseButton}" Margin="8,0,0,0"
                      Click="BrowseGame_Click" ToolTip="Choose where this build's NHL24PC game folder is (saved to settings)" />
              <!-- The stock ComboBox chrome stays light on Windows, so the text is dark to stay readable. -->
              <ComboBox x:Name="BuildSelector" DisplayMemberPath="Name" SelectedValuePath="Id" SelectionChanged="Build_SelectionChanged"
                        Padding="9,6" Background="#e3e9f1" Foreground="#0d1726" BorderBrush="#9fb0c6"
                        ToolTip="{Binding SelectedItem.GameDir, RelativeSource={RelativeSource Self}}" />
            </DockPanel>
            <TextBlock x:Name="BuildTargetText" Foreground="#b3c4da" FontSize="10" Margin="1,4,0,0" TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </Grid>
      </Border>
      <ContentControl x:Name="Page" Grid.Row="1" />
    </Grid>
  </Grid>
</Window>
