<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <None Include="..\..\data\logo_refs.json" Link="data\logo_refs.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\data\salary_cap.json" Link="data\salary_cap.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\data\nhl24-patches.xml" Link="data\nhl24-patches.xml" CopyToOutputDirectory="PreserveNewest" />
    <!-- The scorebug tests rewrite the real style movies in memory (never on disk). -->
    <None Include="..\..\data\scorebug\*.gfx" Link="data\scorebug\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Suite.Core\Suite.Core.csproj" />
    <ProjectReference Include="..\..\src\Suite.Convert27\Suite.Convert27.csproj" />
    <ProjectReference Include="..\..\src\Suite.Scorebug\Suite.Scorebug.csproj" />
  </ItemGroup>

</Project>
