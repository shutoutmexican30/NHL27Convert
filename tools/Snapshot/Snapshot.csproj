<Project Sdk="Microsoft.NET.Sdk">
  <!-- Labeled restore points for the game: Snapshot backup takes the same kind of backup the writer
       takes before an apply (TOCs + CAS lengths) without writing anything; restore puts it back and verifies. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Suite.Core\Suite.Core.csproj" />
  </ItemGroup>
</Project>
