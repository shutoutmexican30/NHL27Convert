<Project Sdk="Microsoft.NET.Sdk">
  <!-- Re-plans portrait slots against the game's own databases, so PortraitWrite never puts a face on someone else. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Suite.Core\Suite.Core.csproj" />
    <ProjectReference Include="..\..\src\Suite.Rosters\Suite.Rosters.csproj" />
  </ItemGroup>
</Project>
