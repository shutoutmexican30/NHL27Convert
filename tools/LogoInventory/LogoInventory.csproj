<Project Sdk="Microsoft.NET.Sdk">
  <!-- Writes every branding / helmet logo sheet in both games as a TSV, with the decoded PNG and a guessed role. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Suite.Core\Suite.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\data\logo_refs.json" Link="data\logo_refs.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>