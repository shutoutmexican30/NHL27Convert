<Project Sdk="Microsoft.NET.Sdk">
  <!-- Ports every non-NHL league's rosters from NHL 27 into copies of NHL 24's roster databases. Writes no game. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Suite.Rosters\Suite.Rosters.csproj" />
  </ItemGroup>
</Project>
