<Project Sdk="Microsoft.NET.Sdk">
  <!-- Replaces chunks everywhere the game reads them (TOC chunk tables + bundle slices + manifest SHA1s), on a copy only. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Suite.Core\Suite.Core.csproj" />
  </ItemGroup>
</Project>
