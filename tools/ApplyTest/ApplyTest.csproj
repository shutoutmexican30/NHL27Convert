<Project Sdk="Microsoft.NET.Sdk">
  <!-- Apply/restore round trip on a COPY of the game. Never point it at the real game folder. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Suite.Core\Suite.Core.csproj" />
    <ProjectReference Include="..\..\src\Suite.Convert27\Suite.Convert27.csproj" />
  </ItemGroup>
</Project>
