<!--
  NHL 24 (CUSA37933) APP_VER 01.60 - the code patches the "NHL24PC V3.2" repack bakes into eboot.bin,
  expressed as runtime memory patches so a CLEAN 1.60 extract stays stock.

  Drop this file in <emulator folder>\user\patches\ and start with the memory patcher enabled
  (shadPS4 style: nhl24.exe -p nhl24.xml). Addresses use the patch repository convention
  Address = 0x400000 + virtual address = 0x400000 + eboot.bin file offset - 0x51D80 (the 1.60 SELF puts the
  code+rodata segment at file 0x51D80 = vaddr 0). Checked against the live emulator: its working replay entry
  0x068E0770 is the je at file 0x065324F0. The comments below still name eboot.bin FILE offsets.
  (Before 2026-11-12 this file used 0x4000000 + file offset, which pointed every entry at the wrong bytes.)

  Where this comes from: a byte diff of the repack's patched game-UPDATE\eboot.bin against the untouched
  eboot.bin.orig kept beside it (188,338,041 bytes; 21 differing bytes in 7 runs). The two runs inside the
  resource area (file 0x09059F50 and 0x09059F54) are language/loc data and are left out of the active
  entries: text is better patched on disk and can be reloaded at runtime.

  VERIFY BEFORE RELYING ON IT: run one clean 1.60 session per entry and confirm the symptom goes away.
  The names say what each byte does to the machine code; they are read off the disassembly, not from the
  repack's source.
-->
<Patch>
  <!-- 0x065324F0: 74 to EB. je to jmp: always take the branch. Same technique the upstream project uses
       for its synchronous replay compression fix, at a different address. -->
  <Metadata Name="Repack A - force the branch at 0x065324F0 (je to jmp)" isEnabled="true" AppVer="01.60" AppElf="eboot.bin" Author="CIMS">
    <PatchList>
      <Line Type="byte" Address="0x068E0770" Value="0xEB" />
    </PatchList>
  </Metadata>
  <!-- 0x05C30524: 8A 86 6E 01 00 00 to 31 C0 90 90 90 90. mov al,[rsi+0x16E] to xor eax,eax + 4 nops,
       so the value read there is always 0. Consistent with switching one effect off. -->
  <Metadata Name="Repack B - zero the byte read at [rsi+0x16E] (0x05C30524)" isEnabled="true" AppVer="01.60" AppElf="eboot.bin" Author="CIMS">
    <PatchList>
      <Line Type="byte" Address="0x05FDE7A4" Value="0x31" />
      <Line Type="byte" Address="0x05FDE7A5" Value="0xC0" />
      <Line Type="byte" Address="0x05FDE7A6" Value="0x90" />
      <Line Type="byte" Address="0x05FDE7A7" Value="0x90" />
      <Line Type="byte" Address="0x05FDE7A8" Value="0x90" />
      <Line Type="byte" Address="0x05FDE7A9" Value="0x90" />
    </PatchList>
  </Metadata>
  <!-- 0x04DD0FC7: 0F B6 8B 6E 01 to 31 C9 0F 1F 44. movzx ecx,[rbx+0x16E] to xor ecx,ecx + nops:
       the same 0x16E field, read through another register, forced to 0. -->
  <Metadata Name="Repack C - zero the byte read at [rbx+0x16E] (0x04DD0FC7)" isEnabled="true" AppVer="01.60" AppElf="eboot.bin" Author="CIMS">
    <PatchList>
      <Line Type="byte" Address="0x0517F247" Value="0x31" />
      <Line Type="byte" Address="0x0517F248" Value="0xC9" />
